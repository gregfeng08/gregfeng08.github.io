# Copy to .env.local (frontend, Vite) and set real values from your Firebase
# project. These VITE_* values are PUBLIC (safe to ship in the client bundle).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_APP_ID=
# Which Google account is the admin (must match ADMIN_EMAIL on the server).
VITE_ADMIN_EMAIL=gregfeng08@gmail.com

# ---- Server-side (set as Cloud Run env vars / secrets, NOT in the bundle) ----
# ADMIN_EMAIL=gregfeng08@gmail.com
# FIREBASE_PROJECT_ID=your-project
# USE_FIRESTORE=true            # auto-on when running on Cloud Run (K_SERVICE)
# DEV_OPEN_ADMIN=true           # LOCAL ONLY: skip auth to test admin UI offline
